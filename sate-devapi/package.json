{
  "name": "sate-devapi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "node test/run.mjs",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute sate-devapi --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute sate-devapi --remote --file=./schema.sql",
    "design:check": "node ../design-system/verify.mjs ./src --ci",
    "pretest": "npm run design:check"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.20.0"
  }
}
