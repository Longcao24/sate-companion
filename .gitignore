# dependencies
node_modules/
mock-server/node_modules/

# Expo / native build output (regenerated by `expo prebuild` / `expo run:ios`).
# ANCHORED to the repo root on purpose: unanchored `ios/` + `android/` also matched
# `modules/*/ios/` and `modules/*/android/`, which silently kept the LOCAL EXPO MODULES'
# own native source (PlaudSateModule.swift, SateAscModule.kt) out of git — source that
# prebuild does not regenerate and that exists nowhere else. The proprietary binaries
# inside those folders stay ignored explicitly, further down.
.expo/
/ios/
/android/
*.ipa
*.apk

# macOS
.DS_Store

# logs
*.log

# mock-server runtime data (created at runtime; not source)
mock-server/data.json
mock-server/uploads/

# firmware build artifacts
*.bin
build/

# Arduino/OTA build output (binaries, elf, map)
ota_build/

# firmware publish admin creds (never commit)
scripts/.publish.env

# secrets — NEVER commit (contains SUPABASE_SERVICE_ROLE_KEY etc.)
.env
.env.local
.env.*.local

# Python bytecode cache
__pycache__/
*.pyc

# Plaud SDK binaries — proprietary, copied in per-machine (see plaud-integration.md)
modules/plaud-sate/ios/Frameworks/
# L816 ASC codec — proprietary vendor binaries lifted from the reference APK,
# copied in per-machine exactly like the Plaud SDK above (see
# modules/sate-asc/README.md). A clone without them still builds; the L816 entry
# point simply does not appear.
modules/sate-asc/android/src/main/jniLibs/

# Supabase CLI link state (per-machine, written by `supabase link`)
supabase/.temp/

# Arduino build outputs
SATE_Recorder/build*/
hwtest/.venv/
hwtest/.mirror.ppm
hwtest/.screen.ppm
hwtest/*.ppm
