{
  "name": "sate-companion",
  "version": "0.5.1",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "sate:prebuild": "SATE_VARIANT=sate expo prebuild -p android --clean",
    "sate:build": "cd android && rm -rf app/build/generated/assets app/build/intermediates/assets && SATE_VARIANT=sate ./gradlew :app:assembleRelease",
    "sate:android": "npm run sate:prebuild && npm run sate:build && adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "companion:prebuild": "expo prebuild -p android --clean",
    "companion:build": "cd android && rm -rf app/build/generated/assets app/build/intermediates/assets && ./gradlew :app:assembleRelease",
    "companion:android": "npm run companion:prebuild && npm run companion:build && adb install -r android/app/build/outputs/apk/release/app-release.apk"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~54.0.10",
    "buffer": "^6.0.3",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.5.0",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "^5.3.3"
  },
  "private": true
}
