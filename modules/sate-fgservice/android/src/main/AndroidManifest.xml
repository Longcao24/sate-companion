<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A library manifest MERGES into the app's, which is why these live here
         rather than in app.json: `android/` is git-ignored and regenerated by
         `expo prebuild`, so anything declared only there is lost on the next
         prebuild. This file survives. -->

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ requires the specific type to be declared as its own
         permission. `connectedDevice` is the honest one: this service exists
         solely to keep a Bluetooth link to the user's recorder alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 13+ : the ongoing notification is not optional for a foreground
         service, but SHOWING it needs runtime consent. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".SateForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
